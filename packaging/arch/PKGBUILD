# Maintainer: juniorbarchini-oss <juniorbarchini-oss@users.noreply.github.com>
pkgname=smartlinux
_tag=1.3.0-beta.3          # git tag version (the release tag is v$_tag)
pkgver=${_tag//-/}         # pkgver may not contain hyphens: 1.3.0beta.1 sorts before 1.3.0
pkgrel=1
pkgdesc="S.M.A.R.T. disk health diagnostics for local and remote (SSH) drives"
arch=('any')
url="https://github.com/juniorbarchini-oss/smartlinux"
license=('MIT')
depends=('python' 'pyside6' 'python-paramiko' 'python-keyring' 'smartmontools')
optdepends=('putty: SSH to very old devices that only offer ssh-dss host keys'
            'polkit: USB compatibility mode (read SMART through adapters that hide it in UAS mode)'
            'udisks2: unmount/remount volumes for the USB compatibility mode'
            'lsof: show which programs keep a USB volume busy')
source=("$pkgname-$_tag.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('14a745bfbe8b48927c3e53b28b7263e1ff460030efeb49d7bd8d045412c22cce')

package() {
  cd "$pkgname-$_tag"

  # Application code
  install -d "$pkgdir/usr/lib/$pkgname"
  cp -r smartlinux "$pkgdir/usr/lib/$pkgname/"
  find "$pkgdir/usr/lib/$pkgname" -name '__pycache__' -type d -prune -exec rm -rf {} +

  # Root helper for the USB compatibility mode (run only through pkexec) + its polkit action
  install -Dm755 packaging/common/usb-mode-helper "$pkgdir/usr/lib/$pkgname/usb-mode-helper"
  install -Dm644 packaging/common/org.smartlinux.usbmode.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.smartlinux.usbmode.policy"

  # Launcher
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/$pkgname" <<'LAUNCHER'
#!/bin/sh
PYTHONPATH=/usr/lib/smartlinux${PYTHONPATH:+:$PYTHONPATH} exec python3 -m smartlinux.main "$@"
LAUNCHER
  chmod 755 "$pkgdir/usr/bin/$pkgname"

  # Desktop entry (Exec points at the installed launcher, not the source tree)
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<'DESKTOP'
[Desktop Entry]
Name=SmartLinux
GenericName=Disk Diagnostic Tool
Comment=S.M.A.R.T. Disk Health Diagnostics & Monitoring
Exec=smartlinux
Icon=smartlinux
Terminal=false
Type=Application
Categories=System;HardwareSettings;Utility;
Keywords=smart;disk;ssd;hdd;nvme;health;telemetry;diagnostic;storage;
StartupWMClass=smartlinux
DESKTOP

  # Icons
  for s in 32 48 64 128 256 512; do
    install -Dm644 "smartlinux/assets/icon_${s}x${s}.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/$pkgname.png"
  done
  install -Dm644 smartlinux/assets/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
